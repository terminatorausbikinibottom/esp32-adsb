# Copy to firmware/.env (gitignored) and edit. Load for a build with: set -a; . ./.env; set +a
# The values below are fictitious placeholders. Never print or commit the real file.

WIFI_SSID=example-ssid
# WPA2-PSK, 8 to 63 bytes
WIFI_KEY=example-passphrase

# IPv4 literal (a host name needs DNS, later step). Not needed when ADSB_DEMO is set.
ADSB_FEED_HOST=192.0.2.10
#ADSB_FEED_PORT=30002

ADSB_RX_LAT=47.0
ADSB_RX_LON=-30.0
#ADSB_RX_ELEV_M=0
#ADSB_RADIUS_KM=5

# Optional: contact in the HTTP User-Agent (planespotters requires one for photos)
# ADSB_HTTP_CONTACT=https://example.invalid/contact

# Optional: overflight | busy (feed the scenario instead of the network)
#ADSB_DEMO=overflight
# Optional: http://<host>:<port> (fallback metadata proxy)
#ADSB_META_PROXY=http://192.0.2.10:8080
