# Copy to sim-bridge/.env (gitignored) and edit. Read from the current directory when the bridge
# is started in sim-bridge/, or from the file named by ADSB_SIM_ENV_FILE. Process env wins.
# The values below are fictitious placeholders.

# Upstream raw-hex feed (host and port of the receiver's TCP output). Unset: live mode disabled.
ADSB_FEED_HOST=192.0.2.1
ADSB_FEED_PORT=30002

# Receiver position served to the sim as /local/config.json. Without lat and lon, live is disabled.
ADSB_RX_LAT=47.0
ADSB_RX_LON=-30.0
ADSB_RX_ELEV_M=0
ADSB_RADIUS_KM=5

# Optional: capture file served for replay mode.
#ADSB_REPLAY_CAPTURE=/path/to/feed.capture

# Optional: simultaneous live browser clients (1..=1024, default 4).
#ADSB_SIM_MAX_CLIENTS=4

# Optional: seconds the upstream feed may stay down before the browser socket is closed so the
# sim shows the feed as lost and reconnects (1..=3600, default 10).
#ADSB_SIM_UPSTREAM_GRACE_S=10
