{
  "name": "esp32-adsb (Rust / esp-hal)",
  "image": "mcr.microsoft.com/devcontainers/base:trixie",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": false,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable",
      "profile": "minimal",
      "components": "rust-src,rustfmt,clippy,rust-analyzer"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    // python3 >= 3.11 for the agentic-harness hooks (trixie ships 3.13).
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "2.102.1"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/rio/features/chezmoi:1": {},
    // beads (bd) task state for the agentic-harness /feature pipeline; embedded mode, no dolt.
    "ghcr.io/eitsupi/devcontainer-features/beads-cli:1": {
      "version": "1.3.1"
    },
    "./features/esp-rs": {
      "targets": "all"
    },
    "./features/neovim": {
      "version": "stable"
    },
    "./features/wasm-sim": {},
    // uv runs the board-bench tools (PEP 723 scripts) and their tests on python 3.11.
    "./features/uv": {
      "version": "0.13.5"
    }
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/common-utils",
    "ghcr.io/devcontainers/features/rust",
    "./features/esp-rs",
    "./features/wasm-sim",
    "./features/neovim"
  ],

  // Simulator (trunk serve) port; VS Code forwards it to the host's localhost.
  // Devcontainer CLI without VS Code: add runArgs "-p", "127.0.0.1:8080:8080" (keep the
  // 127.0.0.1 prefix) and run `trunk serve --address 0.0.0.0` inside the container.
  "forwardPorts": [8080],

  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": false,

  // Podman (rootless): map the host user onto vscode (1000) so the bind-mounted
  // workspace is writable; disable SELinux relabeling for Linux hosts.
  "runArgs": [
    "--userns=keep-id:uid=1000,gid=1000",
    "--security-opt=label=disable"
  ],
  "containerEnv": {
    "HOME": "/home/vscode",
    // No anonymous usage telemetry from bd (and other CLIs honouring the convention).
    "DO_NOT_TRACK": "1",
    "UV_CACHE_DIR": "/home/vscode/.uv/cache",
    "UV_PYTHON_INSTALL_DIR": "/home/vscode/.uv/python"
  },

  "mounts": [
    // Persist cargo downloads across container rebuilds.
    "source=esp32-adsb-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    // Persist uv's cache and managed pythons (bench tests on 3.11) across rebuilds.
    "source=esp32-adsb-uv,target=/home/vscode/.uv,type=volume",
    // Persist Claude Code login/config across container rebuilds.
    "source=esp32-adsb-claude-config,target=/home/vscode/.claude,type=volume",
    // SSH config and personal key (read-only) for git over SSH.
    "source=${localEnv:HOME}/.ssh/config,target=/home/vscode/.ssh/config,type=bind,readonly",
    "source=${localEnv:HOME}/.ssh/personal,target=/home/vscode/.ssh/personal,type=bind,readonly"
  ],

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "fill-labs.dependi",
        "vadimcn.vscode-lldb",
        "probe-rs.probe-rs-debugger"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "rust-analyzer.check.allTargets": false,
        "rust-analyzer.cargo.allTargets": false
      }
    }
  }
}
