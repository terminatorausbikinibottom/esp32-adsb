import "../fonts/LiberationSans-Regular.ttf";
import "../fonts/LiberationSans-Bold.ttf";

export enum CardKind { no-data, overhead, just-passed, quiet, approaching }
export enum Badge { none, overhead, approaching, nearest }

export struct Blip {
    // Centre in the radar box, logical px.
    x: length,
    y: length,
    sprite: image,
    label: string,
    focus: bool,
}

component Dot inherits Rectangle {
    in property <bool> ok;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background: ok ? #3ddc84 : #e5484d;
}

component StatusBar inherits Rectangle {
    in property <bool> wifi-ok;
    in property <bool> feed-ok;
    in property <string> counts;
    in property <string> rate;
    in property <string> clock;
    height: 32px;
    background: #1b1f27;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;
        Dot { ok: wifi-ok; y: 9px; }
        Text { text: "WiFi"; font-size: 16px; color: #9aa4b2; vertical-alignment: center; }
        Dot { ok: feed-ok; y: 9px; }
        Text { text: "Feed"; font-size: 16px; color: #9aa4b2; vertical-alignment: center; }
        Text { text: counts; font-size: 16px; color: #e6e9ef; vertical-alignment: center; }
        Text { text: rate; font-size: 16px; color: #e6e9ef; vertical-alignment: center; }
    }
    Text {
        x: parent.width - self.width - 12px;
        text: clock;
        font-size: 16px;
        color: #e6e9ef;
        vertical-alignment: center;
    }
}

component Ring inherits Rectangle {
    in property <length> radius;
    in property <color> line: #2f3a4d;
    x: 224px - radius;
    y: 224px - radius;
    width: 2 * radius;
    height: 2 * radius;
    border-radius: radius;
    border-width: 1px;
    border-color: line;
}

// "TRK" + "090°": grey caption, value elided to the cell.
component Cell inherits Rectangle {
    in property <string> caption;
    in property <string> value;
    height: 20px;
    Text { x: 0px; width: 40px; text: caption; font-size: 14px; color: #7b8494; vertical-alignment: center; }
    Text { x: 40px; width: parent.width - 40px; text: value; font-size: 17px; color: #e6e9ef; vertical-alignment: center; overflow: elide; }
}

export component AppWindow inherits Window {
    width: 800px;
    height: 480px;
    background: #0e1117;
    default-font-family: "Liberation Sans";

    in property <bool> wifi-ok;
    in property <bool> feed-ok;
    in property <string> counts;
    in property <string> rate;
    in property <string> clock;

    // Radar.
    in property <CardKind> kind;
    in property <[Blip]> blips;
    in property <string> half-label;
    in property <string> range-label;
    in property <string> beyond;
    // Radius of the dim configured-radius ring; 0 hides it.
    in property <length> radius-ring;
    in property <image> plane-icon;

    // Info panel (focus aircraft).
    in property <string> heading: "—";
    in property <Badge> badge;
    in property <string> airline: "—";
    in property <string> model: "—";
    in property <string> registration: "—";
    in property <string> route: "— → —";
    in property <string> cities: "— → —";
    in property <string> alt: "—";
    in property <string> gs: "—";
    in property <string> trk: "—";
    in property <string> dist: "—";

    // Not shown: its literals make the font embedder bake these non-ASCII glyphs in.
    out property <string> glyph-seed: "°→↑↓·±×−–—·áàâäãåçéèêëíìîïñóòôöõøúùûüýÿÁÀÂÄÅÇÉÈÊËÍÎÏÑÓÔÖØÚÛÜßœŠšŽžłŁ";

    StatusBar {
        y: 0px;
        width: parent.width;
        wifi-ok: root.wifi-ok;
        feed-ok: root.feed-ok;
        counts: root.counts;
        rate: root.rate;
        clock: root.clock;
    }

    // Radar box 448 x 448, centre (224, 224) in it, outer ring r = 208.
    Rectangle {
        x: 0px;
        y: 32px;
        width: 448px;
        height: 448px;
        clip: true;
        background: #0a0d12;

        Rectangle { x: 0px; y: 224px; width: 448px; height: 1px; background: #1c2431; }
        Rectangle { x: 224px; y: 0px; width: 1px; height: 448px; background: #1c2431; }
        Ring { radius: 208px; }
        Ring { radius: 104px; }
        if radius-ring > 0px: Ring { radius: radius-ring; line: #4a3b1c; }

        Text { x: 230px; y: 2px; text: "N"; font-size: 16px; font-weight: 700; color: #e6e9ef; }
        Text { x: 230px; y: 122px; text: half-label; font-size: 13px; color: #7b8494; }
        Text { x: 8px; y: 6px; text: range-label; font-size: 16px; font-weight: 700; color: #9aa4b2; }
        Text { x: 8px; y: 424px; text: beyond; font-size: 14px; color: #f5a524; }

        for b in blips: Rectangle {
            Image { x: b.x - 10px; y: b.y - 10px; width: 20px; height: 20px; source: b.sprite; }
            if b.focus: Rectangle {
                x: b.x - 15px;
                y: b.y - 15px;
                width: 30px;
                height: 30px;
                border-radius: 15px;
                border-width: 2px;
                border-color: #ffcc00;
            }
            Text {
                width: 88px;
                x: b.x > 340px ? b.x - 100px : b.x + 13px;
                y: b.y - 8px;
                text: b.label;
                font-size: 14px;
                font-weight: b.focus ? 700 : 400;
                color: b.focus ? #ffffff : #aab4c3;
                horizontal-alignment: b.x > 340px ? right : left;
                overflow: elide;
            }
        }

        if kind == CardKind.no-data: Rectangle {
            x: 24px;
            y: 204px;
            width: 400px;
            height: 40px;
            border-radius: 8px;
            background: #1b1f27;
            border-width: 1px;
            border-color: #e5484d;
            Text { text: "No data: feed disconnected"; font-size: 20px; color: #e6e9ef; horizontal-alignment: center; vertical-alignment: center; }
        }
    }

    // Info panel 352 x 448.
    Rectangle {
        x: 448px;
        y: 32px;
        width: 352px;
        height: 448px;
        background: #11151c;

        Rectangle {
            x: 8px;
            y: 4px;
            width: 336px;
            height: 224px;
            background: #1e232d;
            Image { x: 134px; y: 62px; width: 68px; height: 68px; source: plane-icon; }
            Text { y: 136px; width: parent.width; text: "no photo"; font-size: 16px; color: #7b8494; horizontal-alignment: center; }
        }
        // Photographer credit (RD.7) goes at y = 230.

        Text { x: 8px; y: 246px; width: 220px; text: heading; font-size: 36px; font-weight: 700; color: #ffffff; overflow: elide; }
        if badge != Badge.none: Rectangle {
            x: 232px;
            y: 256px;
            width: 112px;
            height: 24px;
            border-radius: 12px;
            background: badge == Badge.overhead ? #3b82f6 : badge == Badge.approaching ? #f5a524 : #3a4150;
            Text {
                text: badge == Badge.overhead ? "OVERHEAD" : badge == Badge.approaching ? "APPROACHING" : "NEAREST";
                font-size: 13px;
                font-weight: 700;
                color: badge == Badge.approaching ? #0e1117 : #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text { x: 8px; y: 290px; width: 336px; text: airline; font-size: 17px; color: #e6e9ef; overflow: elide; }
        Text { x: 8px; y: 310px; width: 336px; text: model; font-size: 17px; color: #c3c9d4; overflow: elide; }
        Text { x: 8px; y: 330px; width: 336px; text: registration; font-size: 17px; color: #c3c9d4; overflow: elide; }
        Text { x: 8px; y: 352px; width: 336px; text: route; font-size: 26px; font-weight: 700; color: #ffffff; overflow: elide; }
        Text { x: 8px; y: 383px; width: 336px; text: cities; font-size: 15px; color: #9aa4b2; overflow: elide; }
        Cell { x: 8px; y: 404px; width: 210px; caption: "ALT"; value: alt; }
        Cell { x: 222px; y: 404px; width: 122px; caption: "GS"; value: gs; }
        Cell { x: 8px; y: 424px; width: 210px; caption: "DIST"; value: dist; }
        Cell { x: 222px; y: 424px; width: 122px; caption: "TRK"; value: trk; }
    }
}
